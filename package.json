{
  "name": "dishwasher-safe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "validate:content": "node --experimental-strip-types scripts/validate-content.ts",
    "validate:rendered": "node scripts/validate-rendered.mjs",
    "build": "npm run validate:content && astro check && astro build && npm run validate:rendered",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "latest",
    "@astrojs/sitemap": "latest",
    "astro": "^7.2.4",
    "typescript": "latest"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "yaml-language-server": {
      "yaml": ">=2.8.3"
    }
  }
}

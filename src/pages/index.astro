---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Finder from '../components/Finder.astro';
import { findItem, items, materials, verdictLabels, type DishItem } from '../data/items';

const homeUrl = new URL('/', Astro.site).toString();
const popularItemSlugs = [
  'air-fryer-basket',
  'hydro-flask',
  'cutting-boards-plastic',
  'pet-bowls',
  'wooden-spoons',
  'kitchen-knives',
  'baby-bottles',
  'silicone-bibs',
  'nonstick-pans',
  'cast-iron-skillet',
  'yeti-cups',
  'food-storage-containers',
];
const popularItems = popularItemSlugs.map((slug) => findItem(slug)).filter((item): item is DishItem => Boolean(item));
const orderedItems = [...popularItems, ...items.filter((item) => !popularItemSlugs.includes(item.slug))];
const searchText = (item: DishItem) => `${item.name} ${(item.aliases ?? []).join(' ')} ${verdictLabels[item.verdict]}`.toLowerCase();
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Dishwasher Safe?',
    url: homeUrl,
    description: 'Fast dishwasher-safe answers for common kitchen items.',
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Dishwasher-safe guides',
    url: homeUrl,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: orderedItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        url: new URL(`/items/${item.slug}/`, Astro.site).toString(),
      })),
    },
  },
];
---
<BaseLayout title="Dishwasher Safe? Fast yes/no answers" description="Find out whether common kitchen items can go in the dishwasher, where to put them, and what to avoid.">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  <section class="hero">
    <div class="eyebrow"><span class="dot"></span> Direct dishwasher answers</div>
    <h1>Can this go in the <em>dishwasher?</em></h1>
    <p>Pick an item and get the answer first. Then see rack placement, cycle, drying, and the caveats that matter.</p>
    <div class="pills"><span class="pills-label">Every answer is one of</span><span class="chip v-yes">Usually yes</span><span class="chip v-top-rack">Top rack only</span><span class="chip v-no">Usually no</span><span class="chip v-depends">It depends</span></div>
    <Finder />
  </section>

  <section class="section">
    <div class="section-head"><h2>All items</h2><p>Most-searched first. Not listed? <a class="inline-link" href="/materials/">Browse by material</a> instead.</p></div>
    <div class="grid">
      {orderedItems.map((item) => (
        <a class="card" href={`/items/${item.slug}/`} data-search={searchText(item)}>
          <span class="icon-badge"><Icon name="dishwasher" /></span>
          <strong>{item.name}</strong>
          <p><span class={`chip v-${item.verdict}`}>{verdictLabels[item.verdict]}</span></p>
          <p>{item.shortAnswer}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Browse by material</h2><p>When you know what it’s made of but not the exact product.</p></div>
    <div class="grid">
      {materials.map((material) => (
        <a class="card" href={`/materials/${material.slug}/`} data-search={`${material.name} ${verdictLabels[material.defaultVerdict]}`.toLowerCase()}><span class="icon-badge"><Icon name="sparkle" /></span><strong>{material.name}</strong><p>{material.shortAnswer}</p></a>
      ))}
    </div>
  </section>
</BaseLayout>

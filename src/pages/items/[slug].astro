---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { findItem, items, verdictLabels, findMaterial } from '../../data/items';
export function getStaticPaths(){ return items.map((item)=>({ params:{ slug:item.slug }})); }
const item = findItem(Astro.params.slug!); if(!item) throw new Error('Item not found');
const title = `Can you put ${item.name} in the dishwasher?`;
const updatedDate = '2026-05-04';
const updatedLabel = 'Updated May 4, 2026';
const description = `${item.shortAnswer} Includes rack placement, cycle, drying, and caveats.`;
const verdictClass = item.verdict === 'top-rack' ? 'top-rack' : item.verdict;
const homeUrl = new URL('/', Astro.site).toString();
const itemsUrl = new URL('/items/', Astro.site).toString();
const itemUrl = new URL(`/items/${item.slug}/`, Astro.site).toString();
const relatedItems = (item.relatedSlugs ?? [])
  .map((slug) => findItem(slug))
  .filter(Boolean);
const extraFaqs = item.slug === 'air-fryer-basket'
  ? [
    { question: 'Can an air fryer basket go in the dishwasher?', answer: 'Some removable air fryer baskets are dishwasher safe, but only when the manual says that exact basket, tray, drawer, or crisper plate can go in the dishwasher. Hand wash nonstick baskets when the manual is unclear.' },
    { question: 'Are air fryer trays dishwasher safe?', answer: 'Some removable air fryer trays are dishwasher safe, but only when the manual says that exact tray, crisper plate, or drawer can go in the dishwasher. Hand wash nonstick trays when the manual is unclear.' },
    { question: 'Can you put an air fryer itself in the dishwasher?', answer: 'No. Only removable baskets, trays, crisper plates, drawers, or racks can go in the dishwasher, and only when the manual says that exact part is dishwasher safe. Never put the powered air fryer body in the dishwasher.' },
  ]
  : [];
const faqSchema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:[{'@type':'Question',name:title,acceptedAnswer:{'@type':'Answer',text:item.shortAnswer}},{'@type':'Question',name:`Where should ${item.name} go in the dishwasher?`,acceptedAnswer:{'@type':'Answer',text:item.placement}},...extraFaqs.map((faq)=>({'@type':'Question',name:faq.question,acceptedAnswer:{'@type':'Answer',text:faq.answer}}))]};
const breadcrumbSchema = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:homeUrl},{'@type':'ListItem',position:2,name:'Items',item:itemsUrl},{'@type':'ListItem',position:3,name:item.name,item:itemUrl}]};
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  ...(item.aliases ? { alternateName: item.aliases } : {}),
  mainEntityOfPage: itemUrl,
  dateModified: updatedDate,
  inLanguage: 'en-US',
  isAccessibleForFree: true,
  about: [
    { '@type': 'Thing', name: item.name },
    ...item.materials.map((slug) => ({ '@type': 'Thing', name: findMaterial(slug)?.name ?? slug })),
  ],
};
const structuredData = [faqSchema, breadcrumbSchema, articleSchema];
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/items/">Items</a><span aria-hidden="true">/</span><span aria-current="page">{item.name}</span></nav>
  <article class="section">
    <section class="answer-card">
      <span class={`verdict ${verdictClass}`}><Icon name={item.verdict === 'no' ? 'warning' : 'check'} />{verdictLabels[item.verdict]}</span>
      <h1>{title}</h1>
      <p class="answer-text">{item.shortAnswer}</p>
      <p class="updated-line">{updatedLabel}</p>
      <div class="tiles"><div class="tile"><span class="tile-label">Rack</span><span class="tile-value">{item.placement}</span></div><div class="tile"><span class="tile-label">Cycle</span><span class="tile-value">{item.cycle}</span></div><div class="tile"><span class="tile-label">Drying</span><span class="tile-value">{item.dry}</span></div></div>
    </section>
    <section class="section"><h2>Why</h2><p>{item.why}</p></section>
    {item.sourceNote && <section class="section"><h2>Source note</h2><p>{item.sourceNote}</p></section>}
    <section class="section"><h2><Icon name="warning" /> Caveats</h2><ul class="caveats">{item.caveats.map((c)=><li><Icon name="warning" /><span>{c}</span></li>)}</ul></section>
    {relatedItems.length > 0 && <section class="section"><div class="section-head"><h2>Related guides</h2><p>Nearby removable parts can have different dishwasher instructions.</p></div><div class="grid">{relatedItems.map((related)=><a class="card" href={`/items/${related!.slug}/`}><strong>{related!.name}</strong><p>{related!.shortAnswer}</p></a>)}</div></section>}
    <section class="section"><h2>Related materials</h2><div class="link-row">{item.materials.map((slug)=>{ const material = findMaterial(slug); return material && <a class="link-card" href={`/materials/${material.slug}/`}><span>{material.name}</span><Icon name="arrow" /></a>; })}</div></section>
    <section class="section faq"><h2>FAQ</h2><details open><summary>Can {item.name} go on the bottom rack?</summary><p>{item.placement}</p></details><details><summary>Can you use heated dry?</summary><p>{item.dry}</p></details>{extraFaqs.map((faq)=><details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</section>
  </article>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { findMaterial, materials, itemsForMaterial, verdictLabels } from '../../data/items';
export function getStaticPaths(){ return materials.map((material)=>({ params:{ slug:material.slug }})); }
const material = findMaterial(Astro.params.slug!); if(!material) throw new Error('Material not found');
const related = itemsForMaterial(material.slug);
const title = `Is ${material.name} dishwasher safe?`;
const updatedDate = '2026-05-04';
const updatedLabel = 'Updated May 4, 2026';
const description = material.shortAnswer;
const verdictClass = material.defaultVerdict === 'top-rack' ? 'top-rack' : material.defaultVerdict;
const homeUrl = new URL('/', Astro.site).toString();
const materialsUrl = new URL('/materials/', Astro.site).toString();
const materialUrl = new URL(`/materials/${material.slug}/`, Astro.site).toString();
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: 'Materials', item: materialsUrl },
    { '@type': 'ListItem', position: 3, name: material.name, item: materialUrl },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: title, acceptedAnswer: { '@type': 'Answer', text: material.shortAnswer } },
    { '@type': 'Question', name: `What should I watch before dishwashing ${material.name}?`, acceptedAnswer: { '@type': 'Answer', text: material.caveats.join(' ') } },
  ],
};
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  mainEntityOfPage: materialUrl,
  dateModified: updatedDate,
  inLanguage: 'en-US',
  isAccessibleForFree: true,
  about: { '@type': 'Thing', name: material.name },
};
const structuredData = [breadcrumbSchema, faqSchema, articleSchema];
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/materials/">Materials</a><span aria-hidden="true">/</span><span aria-current="page">{material.name}</span></nav>
  <article class="section">
    <section class="answer-card"><span class={`verdict ${verdictClass}`}>{verdictLabels[material.defaultVerdict]}</span><h1>{title}</h1><p class="answer-text">{material.shortAnswer}</p><p class="updated-line">{updatedLabel}</p></section>
    <section class="section"><h2>Caveats</h2><ul class="caveats">{material.caveats.map((c)=><li><Icon name="warning" /><span>{c}</span></li>)}</ul></section>
    <section class="section"><div class="section-head"><h2>Related items</h2><p>Specific examples that include {material.name}.</p></div><div class="grid">{related.map((item)=><a class="card" href={`/items/${item.slug}/`}><strong>{item.name}</strong><p>{item.shortAnswer}</p></a>)}</div></section>
  </article>
</BaseLayout>
